<Window x:Class="TuneDock.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TuneDock.Views"
        Title="TuneDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000">
    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Grid Margin="10">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Grid.Effect>
        <views:PlayerView />
    </Grid>
</Window>
