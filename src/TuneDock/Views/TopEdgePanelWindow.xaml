<Window x:Class="TuneDock.Views.TopEdgePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TuneDock.Views"
        Title="TuneDock Game Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000">
    <!-- The whole card slides vertically from above the screen edge, like the Windows 11 Snap bar. -->
    <Grid x:Name="Slider" Margin="10,0,10,10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="-400" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Grid.Effect>
        <StackPanel>
            <!-- Small gap so the card does not sit flush against the screen edge -->
            <Border Height="10" />
            <views:PlayerView />
        </StackPanel>
    </Grid>
</Window>
